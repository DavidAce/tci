+select = ["0:3", "2"]
+)";
+    }
+    bool rejected = false;
+    try { (void) cfg::readInputConfiguration(path); }
+    catch(const std::invalid_argument &) { rejected = true; }
+    require(rejected, "duplicate selection should be rejected");
+    std::filesystem::remove(path);
